{
  "name": "mern-project",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.2",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "dev:backend": "bun run --filter @penta/backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "dev": "bun run dev:backend",
    "build:frontend": "bun run --filter frontend build",
    "lint:frontend": "bun run --filter frontend lint",
    "preview:frontend": "bun run --filter frontend preview"
  }
}
